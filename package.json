{
  "name": "dsh-plan-progress-pill",
  "version": "0.1.0",
  "description": "DSH Web UI overlay plugin: a collapsible plan & progress capsule showing the session todo list, completed count and current task.",
  "type": "module",
  "license": "MIT",
  "author": "darkzhexue",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plan",
    "progress",
    "todo",
    "overlay",
    "ui"
  ],
  "homepage": "https://github.com/darkzhexue/dsh-plan-progress-pill#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkzhexue/dsh-plan-progress-pill.git"
  },
  "bugs": {
    "url": "https://github.com/darkzhexue/dsh-plan-progress-pill/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE",
    "screenshots.json",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
